@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State

@* Sam "#tresc" przy <base href="/"> prowadził na stronę główną; link przenosi fokus do treści bieżącej strony. *@
<a class="visually-hidden-focusable skip-link" href="#tresc" @onclick="SkipToContentAsync" @onclick:preventDefault>Przejdź do treści</a>

<header class="app-bar">
    <a class="app-bar__brand" href="">
        <svg class="app-bar__logo" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
            <rect width="32" height="32" rx="8" fill="#FFFFFF" />
            <path d="M8.5 23.5c0-6 7.5-4.5 7.5-10.5 0-3.5 3.5-5.5 7.5-5" fill="none" stroke="#0B4F8A" stroke-width="3" stroke-linecap="round" />
            <circle cx="8.5" cy="23.5" r="3.2" fill="#0B4F8A" />
            <circle cx="23.5" cy="8" r="3.6" fill="#E8A317" />
        </svg>
        <span class="app-bar__name">Kraków <span class="app-bar__name-accent">bez barier</span></span>
    </a>
    <div class="app-bar__actions">
    @if (State.User is { } user)
    {
        <span class="app-bar__user"><span class="msym" aria-hidden="true">account_circle</span><span><span class="visually-hidden">Zalogowano jako </span>@user.Login</span></span>
    }
        <button type="button" class="btn app-bar__tour" @onclick="() => _tour!.StartAsync()">Samouczek</button>
    </div>
</header>

<nav class="app-nav" aria-label="Główna nawigacja" data-tour="nav">
    <ul>
        <li>
            <NavLink class="app-nav__link" href="profil">
                <span class="app-nav__icon"><span class="msym" aria-hidden="true">accessibility_new</span></span>
                Profil potrzeb
            </NavLink>
        </li>
        <li>
            <NavLink class="app-nav__link" href="miejsca">
                <span class="app-nav__icon"><span class="msym" aria-hidden="true">location_on</span></span>
                Miejsca
            </NavLink>
        </li>
        <li>
            <NavLink class="app-nav__link" href="plan" data-tour="nav-plan">
                <span class="app-nav__icon"><span class="msym" aria-hidden="true">route</span><span class="app-nav__badge">@State.PlanPlaceIds.Count</span></span>
                Plan
            </NavLink>
        </li>
        <li>
            <NavLink class="app-nav__link" href="zglos">
                <span class="app-nav__icon"><span class="msym" aria-hidden="true">add_location_alt</span></span>
                Zgłoś na mapie
            </NavLink>
        </li>
        <li>
            <NavLink class="app-nav__link" href="konto" data-tour="nav-account">
                <span class="app-nav__icon"><span class="msym" aria-hidden="true">account_circle</span></span>
                Konto
            </NavLink>
        </li>
    </ul>
</nav>

<main id="tresc" class="app-main container" tabindex="-1" @ref="_main">
    @Body
</main>

<footer class="app-footer container">
    Dane o miejscach: @string.Join("; ", State.City?.Sources ?? ["© autorzy OpenStreetMap (ODbL)"]).
    @if (State.City is null or { Coverage: CityCoverage.Full })
    {
        <text>Komunikacja miejska: rozkład GTFS Zarządu Transportu Publicznego w Krakowie. Cechy oznaczone jako „dane demonstracyjne” nie są zweryfikowane.</text>
    }
    else
    {
        <text>Dla tego miasta nie mamy rozkładów komunikacji miejskiej.</text>
    }
    Profil potrzeb jest zapisany tylko na tym urządzeniu, także gdy masz konto.
    <ul class="app-footer__links">
        <li><a href="zrodla-danych">Źródła danych</a></li>
        <li><a href="miasto">Luki w danych i bariery</a></li>
        <li><a href="o-projekcie">O projekcie</a></li>
        <li><a href="konto/firma">Konto firmowe</a></li>
        <li><a href="urzednik">Panel urzędnika</a></li>
    </ul>
</footer>

<AppTour @ref="_tour" />

<div id="blazor-error-ui" role="alert" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <button type="button" class="dismiss btn" aria-label="Zamknij"><span class="msym" aria-hidden="true">close</span></button>
</div>

@code {
    private ElementReference _main;

    private async Task SkipToContentAsync() => await _main.FocusAsync();

    private AppTour? _tour;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += StateHasChanged;
        await State.EnsureLoadedAsync();
    }

    public void Dispose() => State.Changed -= StateHasChanged;
}

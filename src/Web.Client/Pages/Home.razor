@page "/"
@inject AppState State
@inject ISender Sender
@inject NavigationManager Navigation

<PageTitle>Kraków bez barier</PageTitle>

<section class="hero" data-tour="home-intro" aria-labelledby="hero-heading">
    @if (State.User is { } user)
    {
        <h1 id="hero-heading" class="hero__title">Witaj, @user.Login</h1>
        <p class="hero__lead">Twój Kraków bez barier: profil, plan i zgłoszenia w jednym miejscu.</p>
    }
    else
    {
        <h1 id="hero-heading" class="hero__title">Kraków bez barier</h1>
        <p class="hero__lead">Sprawdź, czy miejsce i droga do niego są dostępne właśnie dla Ciebie: na wózku, z dzieckiem, bez wzroku, w ciszy. Ocena dla 11 profili potrzeb, zawsze z uzasadnieniem i źródłem danych.</p>
    }
    <div class="hero__actions">
        <a class="btn hero__btn-primary btn-lg" href="profil">@(State.Profile.IsEmpty ? "Ustaw swój profil potrzeb" : "Zmień profil potrzeb")</a>
        <button type="button" class="btn hero__btn-secondary btn-lg" @onclick="ShowExampleAsync">Pokaż przykład</button>
    </div>
    @if (_facts is { } facts)
    {
        <dl class="hero__facts">
            <div class="hero__fact">
                <dt>miejsc w katalogu, ocenianych pod Twój profil</dt>
                <dd>@facts.Places.ToString("N0", Pl)</dd>
            </div>
            @if (facts.CityDatasets is { } datasets)
            {
                <div class="hero__fact">
                    <dt>zbiorów otwartych danych Miasta Krakowa</dt>
                    <dd>@datasets</dd>
                </div>
            }
            @if (facts.WithoutAccessibleToilet is { } share)
            {
                <div class="hero__fact">
                    <dt>mieszkańców bez dostosowanej toalety publicznej w promieniu 300 m</dt>
                    <dd>@Pct(share)</dd>
                </div>
            }
        </dl>
    }
</section>

<div>
    @if (State.User is not null)
    {
        <!-- Dashboard -->
        <section aria-labelledby="dashboard-heading" data-tour="home-dashboard">
            <h2 id="dashboard-heading" class="section-title">Twój pulpit</h2>
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card card-body h-100">
                        <h3 class="h5">Profil potrzeb</h3>
                        <ProfileOverview Max="5" />
                        <a class="btn btn-outline-primary mt-auto align-self-start" href="konto/profil">
                            @(State.Profile.IsEmpty ? "Ustaw profil" : "Edytuj profil")
                        </a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card card-body h-100">
                        <h3 class="h5">Plan</h3>
                        <p class="mb-1"><span class="dash-number">@State.PlanPlaceIds.Count</span> @Labels.PlacesWord(State.PlanPlaceIds.Count) w planie@(State.ActivePlan is { } active ? $" „{active.Name}”" : "")</p>
                        <p class="text-body-secondary">
                            @(State.PlanPlaceIds.Count == 0
                                ? "Wybierz miejsca, a ułożymy trasę z ostrzeżeniami o utrudnieniach."
                                : "Ułóż trasę po ulicach, z komunikacją miejską i ostrzeżeniami o utrudnieniach.")
                        </p>
                        <a class="btn btn-outline-primary mt-auto align-self-start" href="@(State.PlanPlaceIds.Count == 0 && State.Plans.Count == 0 ? "miejsca" : "plan")">
                            @(State.PlanPlaceIds.Count == 0 && State.Plans.Count == 0 ? "Wybierz miejsca" : State.Plans.Count > 1 ? "Otwórz plany" : "Otwórz plan")
                        </a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card card-body h-100">
                        <h3 class="h5">Moje zgłoszenia</h3>
                        @if (_summary is null)
                        {
                            <p class="text-body-secondary" role="status">@(_summaryError ?? "Wczytuję…")</p>
                        }
                        else if (_summary.Total == 0)
                        {
                            <p class="text-body-secondary">Nie masz jeszcze zgłoszeń. Widzisz barierę, hałas albo tłum? Daj znać urzędowi.</p>
                        }
                        else
                        {
                            <p class="mb-1"><span class="dash-number">@_summary.Total</span> wysłanych</p>
                            <ul class="list-unstyled mb-2">
                                <li>czeka na decyzję: <strong>@_summary.Waiting</strong></li>
                                <li>w toku: <strong>@_summary.InProgress</strong></li>
                                <li>załatwione lub potwierdzone: <strong>@_summary.Done</strong></li>
                                <li>z odpowiedzią urzędu: <strong>@_summary.Answered</strong></li>
                            </ul>
                        }
                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            <a class="btn btn-outline-primary" href="konto">Zobacz zgłoszenia</a>
                            <a class="btn btn-outline-secondary" href="zglos">Zgłoś na mapie</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- Mode Selection -->
    <section class="py-4 @(State.User is null ? "" : "mt-4")">
        <h2 class="section-title">Co chcesz zrobić?</h2>
        <div class="row g-4">
            <div class="col-lg-6">
                <button type="button" class="mode-card" @onclick="() => ChooseAsync(AppMode.Sightseeing)">
                    <span class="mode-icon"><span class="msym" aria-hidden="true">explore</span></span>
                    <span class="mode-title">Zwiedzam</span>
                    <span class="mode-subtitle">Atrakcje, muzea, kawiarnie i kultura</span>
                    <span class="mode-description">Odkrywaj Kraków dostosowany do Twoich potrzeb</span>
                </button>
            </div>
            <div class="col-lg-6">
                <button type="button" class="mode-card" @onclick="() => ChooseAsync(AppMode.Errand)">
                    <span class="mode-icon"><span class="msym" aria-hidden="true">assignment_turned_in</span></span>
                    <span class="mode-title">Załatwiam sprawę</span>
                    <span class="mode-subtitle">Urzędy, przychodnie, biblioteki</span>
                    <span class="mode-description">Zaplanuj sprawnie swój dzień</span>
                </button>
            </div>
        </div>
    </section>

    <!-- Dla miasta: funkcje dla urzędu i szybki przykład -->
    <section class="py-4 mt-2" aria-labelledby="city-heading">
        <h2 id="city-heading" class="section-title">Zobacz w minutę</h2>
        <div class="row g-4">
            <div class="col-md-6 col-xl-3">
                <div class="card card-body h-100 feature-card">
                    <div class="feature-icon" aria-hidden="true"><span class="msym">accessible</span></div>
                    <h3 class="h5 mt-3">Przykład: wózek w urzędzie</h3>
                    <p class="text-body-secondary">Ocena Urzędu Miasta Krakowa dla osoby na wózku ręcznym: udogodnienia, braki danych, źródło i data każdej informacji (część cech to oznaczone dane demonstracyjne).</p>
                    <button type="button" class="btn btn-outline-primary mt-auto align-self-start" @onclick="ShowExampleAsync">Pokaż przykład</button>
                    <p class="small text-body-secondary mt-2 mb-0">Ustawi profil „Wózek ręczny”; zmienisz go w każdej chwili.</p>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card card-body h-100 feature-card">
                    <div class="feature-icon" aria-hidden="true"><span class="msym">map</span></div>
                    <h3 class="h5 mt-3">Luki w danych i bariery</h3>
                    <p class="text-body-secondary">Dla urzędu: pokrycie danymi w dzielnicach, udogodnienia w zasięgu mieszkańców i seniorów, planer inwestycji (wiaty, toalety), eksport CSV i GeoJSON.</p>
                    <a class="btn btn-outline-primary mt-auto align-self-start" href="miasto">Otwórz raport miasta</a>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card card-body h-100 feature-card">
                    <div class="feature-icon" aria-hidden="true"><span class="msym">verified</span></div>
                    <h3 class="h5 mt-3">Panel urzędnika</h3>
                    <p class="text-body-secondary">Zgłoszenia mieszkańców: urzędnik potwierdza barierę, a ocena miejsc i trasy uwzględniają ją od razu.</p>
                    <a class="btn btn-outline-primary mt-auto align-self-start" href="urzednik">Przejdź do panelu</a>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card card-body h-100 feature-card">
                    <div class="feature-icon" aria-hidden="true"><span class="msym">location_on</span></div>
                    <h3 class="h5 mt-3">Otwarte dane miasta</h3>
                    <p class="text-body-secondary">Każdy zbiór z adresem, licencją, datą i sposobem aktualizacji, w tym 8 zbiorów z portali miasta (MSIP).</p>
                    <a class="btn btn-outline-primary mt-auto align-self-start" href="zrodla-danych">Zobacz źródła danych</a>
                </div>
            </div>
        </div>
    </section>

    @if (State.User is null)
    {
        <!-- Co daje aplikacja -->
        <section class="py-4 mt-4" aria-labelledby="features-heading">
            <h2 id="features-heading" class="section-title">Co tu znajdziesz</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card card-body h-100 feature-card">
                        <div class="feature-icon" aria-hidden="true"><span class="msym">explore</span></div>
                        <h3 class="h5 mt-3">Miejsca ocenione pod Ciebie</h3>
                        <p class="text-body-secondary">Ustaw profil potrzeb, a pokażemy, które miejsca są dostępne, a gdzie czeka bariera. Brak danych nigdy nie udaje dostępności.</p>
                        <a class="mt-auto" href="profil">@(State.Profile.IsEmpty ? "Ustaw profil potrzeb" : "Zmień profil potrzeb")</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card card-body h-100 feature-card">
                        <div class="feature-icon" aria-hidden="true"><span class="msym">route</span></div>
                        <h3 class="h5 mt-3">Plan trasy</h3>
                        <p class="text-body-secondary">Trasa po ulicach dobrana do profilu, podjazd komunikacją miejską i ostrzeżenia o utrudnieniach potwierdzonych przez urząd.</p>
                        <a class="mt-auto" href="miejsca">Wybierz miejsca do planu</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card card-body h-100 feature-card">
                        <div class="feature-icon" aria-hidden="true"><span class="msym">add_location_alt</span></div>
                        <h3 class="h5 mt-3">Zgłoszenia do urzędu</h3>
                        <p class="text-body-secondary">Zaznacz na mapie przeszkodę, hałas albo tłum lub zgłoś brak udogodnienia w miejscu. Do wysłania potrzebne jest konto.</p>
                        <a class="mt-auto" href="zglos">Zobacz mapę zgłoszeń</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Zachęta do konta -->
        <section class="mt-4 cta-section text-center" aria-labelledby="account-cta-heading">
            <h2 id="account-cta-heading" class="h3 mb-3">Załóż konto: wystarczy login i hasło</h2>
            <p class="mb-4">
                Z kontem wysyłasz zgłoszenia, śledzisz odpowiedzi urzędu i masz zapisany profil potrzeb.
                @(State.Profile.IsEmpty ? "" : "Profil ustawiony teraz przejdzie na Twoje konto.")
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a class="btn btn-primary btn-lg" href="konto?nowe=true">Załóż konto</a>
                <a class="btn btn-outline-primary btn-lg" href="konto">Mam konto</a>
            </div>
        </section>
    }
</div>

@code {
    // WebAssembly nie ma danych kultur, więc polski separator tysięcy (spacja) ustawiamy sami.
    private static readonly System.Globalization.NumberFormatInfo Pl = new() { NumberGroupSeparator = " ", NumberDecimalDigits = 0 };

    private MyReportsSummary? _summary;
    private string? _summaryError;
    private HomeFacts? _facts;

    private static string Pct(double share) => (share * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture).Replace('.', ',') + "%";

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureLoadedAsync();
        // Liczby są z lekkich plików; bez nich pierwszy ekran po prostu ich nie pokazuje.
        if (await Sender.Send(new GetHomeFactsQuery(State.CityId)) is { IsSuccess: true } facts)
            _facts = facts.Value;
        if (State.User is null)
            return;

        var reports = await Sender.Send(new GetMyReportsQuery());
        var hazards = await Sender.Send(new GetMyHazardsQuery());
        if (reports.IsFailure || hazards.IsFailure)
        {
            _summaryError = "Nie udało się wczytać zgłoszeń. Spróbuj później.";
            return;
        }

        _summary = MyReportsSummary.From(reports.Value, hazards.Value);
    }

    /// <summary>Karta z danymi z miasta, OSM i (oznaczonymi) danymi demonstracyjnymi, więc widać wszystkie rodzaje informacji.</summary>
    private const string ExamplePlaceId = "osm-way-404255986";

    private async Task ShowExampleAsync()
    {
        await State.SetProfileAsync(NeedsProfilePresets.Build([NeedsProfilePresets.ManualWheelchair]));
        Navigation.NavigateTo($"miejsca/{ExamplePlaceId}");
    }

    private async Task ChooseAsync(AppMode mode)
    {
        await State.SetModeAsync(mode);
        // Ocena miejsc zależy od profilu, więc bez niego najpierw prowadzimy do jego ustawienia.
        Navigation.NavigateTo(State.Profile.IsEmpty ? "profil" : "miejsca");
    }
}

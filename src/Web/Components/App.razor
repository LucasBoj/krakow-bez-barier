@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Kraków bez barier</title>
    <meta name="description" content="@Description" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content="Kraków bez barier" />
    <meta property="og:description" content="@Description" />
    @if (BaseUrl is { } baseUrl)
    {
        <meta property="og:url" content="@($"{baseUrl}/")" />
        <meta property="og:image" content="@($"{baseUrl}/og-image.png")" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    <ResourcePreloader />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0B3D6B" />
    <link rel="preload" href="fonts/roboto-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/roboto-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/material-symbols-outlined-subset.woff2" as="font" type="font/woff2" crossorigin />
    @* Z Bootstrapa zostaje reset, siatka i klasy pomocnicze; komponenty mają własne style na tokenach M3. *@
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap-reboot.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap-grid.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap-utilities.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/leaflet/leaflet.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Blazor.DriverJs/driverjs.css"]" />
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["css/components.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/modern.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="favicon.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <script src="@Assets["lib/leaflet/leaflet.js"]"></script>
    <script src="@Assets["_content/Blazor.DriverJs/driverjs.js"]"></script>
    <script src="@Assets["js/driverjs-fix.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private const string Description =
        "Dostępność miejsc i tras w Krakowie oceniona dla 11 profili potrzeb, na otwartych danych miasta. Bariery, udogodnienia i braki danych ze źródłem i datą.";

    /// <summary>Publiczny adres z konfiguracji (ten sam co w kodach QR); podglądy linków wymagają adresu bezwzględnego obrazka.</summary>
    private string? BaseUrl => Configuration[Web.Endpoints.BusinessEndpoints.PublicBaseUrlSetting] is { Length: > 0 } url ? url.TrimEnd('/') : null;
}
